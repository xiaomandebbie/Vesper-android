# 复制成 /opt/android-mcp/.env 后 chmod 600
# 真正的 .env 不进仓库（.gitignore 已挡）

# 必填：16 位以上可打印 ASCII，建议 32 位随机
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ANDROID_MCP_TOKEN=

# 对外域名，要和网关配置里的 server_name / 站点名一致
ANDROID_MCP_PUBLIC_HOST=android.vesperphosphor.online

# 两个内部端口，只监听 127.0.0.1，不要在安全组里开放
# 这台机器已占用：8787(Aru Host) 8888/6873(Uranus) 3001 3002 3003 3011 3020 8791 9090 18001
ANDROID_MCP_WS_PORT=18765
ANDROID_MCP_HTTP_PORT=18766

# WebSocket 单条消息上限（MB）。截图报 1009 message too big 就调这个，不是调网关 buffer
ANDROID_MCP_MAX_WS_MB=16

# 手机侧单次请求超时（秒）
ANDROID_MCP_PHONE_TIMEOUT=30
